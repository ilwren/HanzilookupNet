<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(HanziLookupLibraryTargetFrameworks)</TargetFrameworks>
    <RootNamespace>HanziLookup.Avalonia</RootNamespace>
    <AssemblyName>HanziLookup.Avalonia</AssemblyName>

    <!-- NuGet metadata -->
    <PackageId>HanziLookup.Avalonia</PackageId>
    <Version>1.0.0</Version>
    <Authors>HanziLookupNet contributors</Authors>
    <Description>Avalonia controls for HanziLookup: a stroke input canvas (with stroke replay animation and analysis overlay) and a sub-stroke skeleton preview for handwriting recognition candidates.</Description>
    <PackageTags>avalonia;hanzi;handwriting;recognition;chinese;stroke</PackageTags>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/ilwren/HanzilookupNet</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- The controls are plain code (no XAML, no reflection, no bindings), so they are safe to trim. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!--
      A new trim/AOT warning is a compatibility regression in the controls, not a style nit,
      so it fails the build instead of scrolling past.
    -->
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2055;IL2067;IL2070;IL2072;IL2075;IL2091;IL3050;IL3051</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HanziLookup\HanziLookup.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\docs\PORT-NOTES.md" Pack="true" PackagePath="docs\" Visible="false" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(HanziLookupLibraryTargetFrameworks)</TargetFrameworks>
    <RootNamespace>HanziLookup</RootNamespace>
    <AssemblyName>HanziLookup</AssemblyName>

    <!-- NuGet metadata -->
    <PackageId>HanziLookup</PackageId>
    <Version>1.0.0</Version>
    <Authors>HanziLookupNet contributors</Authors>
    <Description>C# rewrite of the hanzilookup-js npm package (v1.0.3): offline handwritten Chinese character recognition using sub-stroke matching. Logic compatible with the original HanziLookupJS by Gabor L Ugray.</Description>
    <PackageTags>hanzi;handwriting;recognition;chinese;stroke;input</PackageTags>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/ilwren/HanzilookupNet</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!--
      The recognizer is written to be trim- and native AOT-safe: it uses no reflection, no runtime
      code generation and only the reflection-free part of System.Text.Json (JsonDocument). Setting
      IsAotCompatible turns on the .NET trim/AOT analyzers for this project (so any future reflection
      shows up as a build warning) and marks the assembly as trimmable, which tells consuming
      applications that they may safely trim it. tools/aot-smoke both publishes and *runs* it as a
      native AOT binary on CI.
    -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\docs\PORT-NOTES.md" Pack="true" PackagePath="docs\" Visible="false" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
